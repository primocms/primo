# Reference configuration for an EXISTING disposable server. This file deploys nothing.
# Set these through that server's existing environment/configuration mechanism.
PRIMO_DEV_MODE=0
PRIMO_AUTHOR_MODE=both
PRIMO_ENABLE_USAGE_STATS=false
PRIMO_APP_URL=https://cms.staging.example.test
PRIMO_BASE_DOMAIN=sites.staging.example.test
PRIMO_DOMAIN_PROVIDER=manual
# Empty means same-origin only; list exact origins if the test architecture needs CORS.
CORS_ALLOWED_ORIGINS=
# SMTP settings belong to PocketBase Settings > Mail, not arbitrary SMTP_* environment variables.
# Bootstrap admin credentials, production secrets, and live storage/billing integrations are omitted.
