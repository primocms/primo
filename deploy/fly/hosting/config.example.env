# EXAMPLE ONLY. Never commit live values. Import production values as Fly secrets.
HOSTING_CUSTOMER_IMAGE=registry.fly.io/primo-hosted-smoke@sha256:945631b84980737d2de5356a0511abb518080b1fe16572b600a845b3b3430ebc
HOSTING_CUTOVER_AT=REPLACE_WITH_ACTUAL_LAUNCH_TIME
# Use product UUIDs from Polar, not checkout-link IDs. Bind monthly and annual products separately.
# Maker requires an image with the owner-only guard; legacy editor cap 0 means unlimited.
HOSTING_PRODUCTS={"MAKER_PRODUCT_UUID":{"name":"Maker","sites":3,"editors":0,"owner_only":true},"SOLO_PRODUCT_UUID":{"name":"Solo","sites":7,"editors":2}}
HOSTING_BILLING_URL=https://polar.sh/REPLACE_WITH_ORG_SLUG/portal
HOSTING_FROM_EMAIL=Primo <REPLACE_WITH_VERIFIED_SENDER>
HOSTING_ALERT_EMAIL=REPLACE_WITH_OPERATOR_EMAIL
HOSTING_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
HOSTING_OPS_TOKEN=REPLACE_WITH_RANDOM_32_PLUS_CHARACTERS
# Separate read-only key for the external monitor; never share the operator key.
HOSTING_MONITOR_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_32_PLUS_CHARACTERS
FLY_API_TOKEN=REPLACE_WITH_PRIMO_HOSTED_ORG_TOKEN
CLOUDFLARE_ZONE_ID=REPLACE_WITH_PRIMO_PAGE_ZONE_ID
CLOUDFLARE_API_TOKEN=REPLACE_WITH_PRIMO_PAGE_DNS_EDIT_TOKEN
POLAR_WEBHOOK_SECRET=REPLACE_WITH_NEW_ENDPOINT_SECRET
RESEND_API_KEY=REPLACE_WITH_SENDING_ONLY_API_KEY
# Enable after verifying a restore; the private age recovery identity stays off Fly.
HOSTING_BACKUPS_ENABLED=true
HOSTING_R2_BUCKET=primo-hosted-backups
HOSTING_R2_REGION=auto
HOSTING_R2_ENDPOINT=https://ff5f3f8917642d3f91fe4898a9d89ee2.r2.cloudflarestorage.com
HOSTING_R2_ACCESS_KEY=REPLACE_WITH_BUCKET_ONLY_ACCESS_KEY
HOSTING_R2_SECRET_KEY=REPLACE_WITH_BUCKET_ONLY_SECRET_KEY
HOSTING_BACKUP_RECIPIENT=REPLACE_WITH_PUBLIC_AGE_RECIPIENT
