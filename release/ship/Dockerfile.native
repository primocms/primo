FROM gcr.io/distroless/base-debian13@sha256:389cad21f73e4c37b94ffe5b13736d5a92bd5bd3c6c6b38c2be1c881e14ba2bd
ARG TARGETARCH
COPY --chmod=0755 .release-image/primo_linux_${TARGETARCH} /app/primo
ENV PRIMO_SUPERUSER_EMAIL=""
ENV PRIMO_SUPERUSER_PASSWORD=""
ENV PRIMO_USER_EMAIL=""
ENV PRIMO_USER_PASSWORD=""
EXPOSE 8080
WORKDIR /app
CMD ["./primo", "serve", "--http=0.0.0.0:8080"]
