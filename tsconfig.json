{
	"extends": "$app/tsconfig",
	"include": ["src/**/*.js", "src/**/*.ts", "src/**/*.svelte", "tests/**/*.js", "tests/**/*.ts", "tests/**/*.svelte", "vite.config.js"],
	"exclude": ["node_modules", "internal/build", "src/service-worker"],
	"compilerOptions": {
		"paths": { "$lib/*": ["./src/lib/*"], "$lib": ["./src/lib/index.js"] },
		"allowJs": true,
		"allowImportingTsExtensions": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"noImplicitAny": false
	}

	// Keep the existing library alias aligned with app.config.js.
	//
	// Includes preserve the previous source/type-check surface; module-only QA
	// scripts are exercised separately by their regression suites.
}
